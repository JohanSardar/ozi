{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off",
  },
  "ignore": [".repos/**"],
  "ignoreBinaries": ["file", "mkfifo", "pkg-config", "plutil", "sips"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    ".": {
      "project": ["*.{js,mjs,cjs,ts,mts,cts}"],
      "entry": [".coderabbit.config.ts"],
      "vitest": {
        "entry": [],
      },
    },
    "scripts": {
      "entry": ["knip-schemas.ts", "verify-windows-desktop-artifact.ts"],
      "ignoreDependencies": ["esbuild"],
    },
    "e2e": {
      "entry": ["*.test.ts", "panel.tsx", "fakes/*.{mjs,ts}"],
      "ignoreDependencies": ["@anthropic-ai/claude-code", "@earendil-works/pi-coding-agent"],
    },
    "apps/server": {
      "entry": ["src/bin.ts!", "src/claude-history-worker.ts!", "scripts/cli.ts"],
      "ignoreDependencies": [
        "@effect/platform-node-shared",
        "@t3tools/web",
        "@napi-rs/keyring",
        "pi-claude-bridge",
      ],
    },
    "apps/desktop": {
      "entry": [
        "gnome-extension/extension.js!",
        "src/electron/WindowsForegroundFocusWorker.ts!",
        "src/snapShot/GlobalShiftShortcutWorker.ts!",
        "src/snapShot/RegionSnapShotWorker.ts!",
        "src/snapShot/SnapShotAccessibilityWorker.ts!",
        "src/boot.ts!",
        "src/compileCache.ts!",
        "src/main.ts!",
        "src/preload.ts!",
        "src/preview-pick-preload.ts!",
        "src/preview-pip-preload.ts!",
        "src/mac-permission-preload.ts!",
        "src/preview/Annotation.css!",
      ],
      "ignoreDependencies": ["playwright-core", "electron-builder"],
      "ignoreUnresolved": ["./compileCache.cjs", "./main.cjs", "gi:*", "resource:*"],
    },
    "apps/web": {
      "entry": ["scripts/warm-dep-cache.ts"],
      "ignoreIssues": {
        "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"],
      },
    },
    "packages/*": {
      "includeEntryExports": true,
    },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "ignoreIssues": {
        "src/_generated/**": ["exports", "types"],
      },
    },
    "packages/provider-pi": {
      "includeEntryExports": true,
      "ignoreDependencies": ["pi-claude-bridge"],
    },
  },
}
